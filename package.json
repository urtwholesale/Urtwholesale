{
  "name": "urbanrat-store",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:store": "vite apps/store --port 5173 --host",
    "dev:admin": "vite apps/admin --port 5174 --host",
    "dev": "concurrently -n \"store,admin\" -c \"blue,green\" \"npm run dev:store\" \"npm run dev:admin\"",
    "build:store": "tsc -p apps/store/tsconfig.json && vite build apps/store",
    "build:admin": "tsc -p apps/admin/tsconfig.json && vite build apps/admin",
    "build": "npm run build:store && npm run build:admin && node -e \"const fs = require('fs'); fs.cpSync('apps/store/dist', 'dist', { recursive: true }); fs.cpSync('apps/admin/dist', 'dist/admin', { recursive: true });\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@types/papaparse": "^5.5.2",
    "lucide-react": "^1.16.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^10.0.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
}
